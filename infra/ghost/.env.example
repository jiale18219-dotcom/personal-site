# Copy this file to .env on the deployment host and replace all values.
# Do not commit infra/ghost/.env.

GHOST_URL=https://blog.yorick.dev
GHOST_HOST_PORT=2368

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=ghost_prod
MYSQL_USER=ghost
MYSQL_PASSWORD=replace-with-a-long-random-ghost-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
